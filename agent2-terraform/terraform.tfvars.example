############################################
# Example tfvars for ODAA Exadata, 100 TB usable
# Copy to terraform.tfvars and edit per environment.
############################################

project             = "exam"          # 3-10 lowercase, used in names
environment         = "prod"
location            = "eastus"        # must be an ODAA-enabled region
resource_group_name = "rg-exam-prod-odaa"
availability_zone   = "2"             # ODAA-enabled AZ in the region

# ---- Exadata Infrastructure ----
exa_infra_display_name = "exam-prod-exa-infra"
exa_shape              = "Exadata.X9M"
compute_count          = 2            # 2 DB nodes
storage_count          = 3            # 3 cells -> ~190 TB raw, supports 100 TB usable
customer_contacts      = ["dba-team@example.com", "oncall@example.com"]

maintenance_window = {
  preference         = "CustomPreference"
  patching_mode      = "Rolling"
  months             = ["January", "April", "July", "October"]
  weeks_of_month     = [2]
  days_of_week       = ["Sunday"]
  hours_of_day       = [4]
  lead_time_in_weeks = 2
}

# ---- VM Cluster ----
vmcluster_display_name      = "exam-prod-vmc"
cluster_name                = "exampprdc1"
hostname_prefix             = "exampprd"
gi_version                  = "19.0.0.0"
license_model               = "BringYourOwnLicense"
cpu_core_count              = 32             # 16 OCPU per node
memory_size_in_gbs          = 720
db_node_storage_size_in_gbs = 500
data_storage_size_in_tbs    = 100            # <-- 100 TB target
data_storage_percentage     = 80
is_local_backup_enabled     = false
is_sparse_diskgroup_enabled = false
time_zone                   = "UTC"
domain                      = "odaa.example.internal"

# Provide existing keys, or leave empty to auto-generate
ssh_public_keys     = []
ssh_key_output_path = "./generated_id_rsa"

data_collection_options = {
  diagnostics_events_enabled = true
  health_monitoring_enabled  = true
  incident_logs_enabled      = true
}

# ---- Networking ----
create_network     = true
vnet_name          = "vnet-exam-prod-odaa"
vnet_address_space = ["10.50.0.0/16"]
client_subnet_name = "snet-odaa-client"
client_subnet_cidr = "10.50.10.0/24"
backup_subnet_name = "snet-odaa-backup"
backup_subnet_cidr = "10.50.11.0/24"

nsg_allowed_source_cidrs = [
  "10.0.0.0/8",       # internal corp
  "10.100.0.0/16",    # migration host subnet
]

tags = {
  cost_center = "DB-OPS-001"
  data_class  = "confidential"
  owner       = "dba-team@example.com"
}
