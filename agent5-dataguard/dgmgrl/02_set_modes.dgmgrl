-- 02_set_modes.dgmgrl — set protection / transport / apply modes on the standby.
-- Bindings:
--   ${STANDBY_UNIQUE_NAME}
--   ${PROTECTION_MODE}      — MAX_PERFORMANCE | MAX_AVAILABILITY | MAX_PROTECTION
--   ${TRANSPORT_MODE}       — ASYNC | SYNC | FASTSYNC
--   ${APPLY_MODE}           — REAL_TIME_APPLY | ARCHIVED_LOG_APPLY

EDIT DATABASE '${STANDBY_UNIQUE_NAME}' SET PROPERTY 'LogXptMode'='${TRANSPORT_MODE}';
EDIT DATABASE '${STANDBY_UNIQUE_NAME}' SET PROPERTY 'StandbyFileManagement'='AUTO';
EDIT DATABASE '${STANDBY_UNIQUE_NAME}' SET PROPERTY 'NetTimeout'='30';
EDIT DATABASE '${STANDBY_UNIQUE_NAME}' SET PROPERTY 'MaxFailure'='5';
EDIT DATABASE '${STANDBY_UNIQUE_NAME}' SET PROPERTY 'MaxConnections'='4';
EDIT DATABASE '${STANDBY_UNIQUE_NAME}' SET PROPERTY 'ReopenSecs'='15';

EDIT CONFIGURATION SET PROTECTION MODE AS ${PROTECTION_MODE};

-- Real-time apply ON when redo apply enables (REAL_TIME_APPLY default in 19c+).
SHOW CONFIGURATION VERBOSE;
SHOW DATABASE VERBOSE '${STANDBY_UNIQUE_NAME}';
